powershell -NoProfile -Command "$q='name,pstate,utilization.gpu,utilization.memory,temperature.gpu,fan.speed,memory.total,memory.used,memory.free,power.draw,power.limit,clocks.current.graphics,clocks.current.memory'; while($true){Clear-Host; Write-Host '========= GPU MONITOR =========' -ForegroundColor Cyan; Write-Host ('Updated: '+(Get-Date)); $lines=nvidia-smi --query-gpu=$q --format=csv,noheader,nounits; foreach($line in $lines){$v=$line -split ',\s*'; $labels=@('GPU Name','Performance State','GPU Utilization %','Memory Utilization %','GPU Temperature (C)','Fan Speed %','Total VRAM (MiB)','Used VRAM (MiB)','Free VRAM (MiB)','Power Draw (W)','Power Limit (W)','Graphics Clock (MHz)','Memory Clock (MHz)'); $out=for($i=0;$i -lt $labels.Count;$i++){[PSCustomObject]@{Statistic=$labels[$i];Value=$(if($i -lt $v.Count){$v[$i]}else{'N/A'})}}; $out | Format-Table -AutoSize}; Write-Host 'Press Ctrl+C to exit.' -ForegroundColor Yellow; Start-Sleep 1}"

